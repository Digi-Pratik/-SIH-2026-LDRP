<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jaspon — Early Warning for Student Dropout</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<style>
  :root{
    --paper:#ECEBE3;
    --paper-raised:#F4F3EC;
    --ink:#22282B;
    --ink-soft:#565F63;
    --line:#C9CDBF;
    --line-strong:#A9AE9D;
    --accent:#2B4257;
    --accent-soft:#D9E1E6;
    --safe:#3F6B4A;
    --safe-bg:#E1E9DF;
    --watch:#B08334;
    --watch-bg:#F0E4CB;
    --risk:#A23E33;
    --risk-bg:#F1DDD7;
    --radius:3px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    line-height:1.5;
  }
  h1,h2,h3,.slab{font-family:'Roboto Slab',serif;}
  .mono{font-family:'IBM Plex Mono',monospace;}

  body::before{
    content:"";
    position:fixed; inset:0;
    background-image: repeating-linear-gradient(180deg, rgba(34,40,43,0.028) 0px, rgba(34,40,43,0.028) 1px, transparent 1px, transparent 34px);
    pointer-events:none;
    z-index:0;
  }

  /* NAV */
  header.topbar{
    position:sticky; top:0; z-index:50;
    background:var(--accent);
    color:#EEEDE4;
    border-bottom:3px solid #1B2E3C;
  }
  .topbar-inner{
    max-width:1180px; margin:0 auto;
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 24px;
  }
  .brand{display:flex; align-items:center; gap:10px;}
  .brand-mark{ flex-shrink:0; display:block; }
  .brand-name{font-family:'Roboto Slab',serif; font-weight:700; font-size:19px; letter-spacing:0.2px;}
  .brand-sub{font-size:11px; color:#C7D2D9; text-transform:uppercase; letter-spacing:1.2px; margin-top:1px;}
  nav.tabs{display:flex; gap:2px; flex-wrap:wrap;}
  nav.tabs button{
    background:none; border:none; color:#D7DEE3;
    font-family:'Inter',sans-serif; font-size:13.5px; font-weight:500;
    padding:9px 14px; cursor:pointer; border-radius:2px;
    transition:background .15s, color .15s;
    letter-spacing:0.2px;
  }
  nav.tabs button:hover{background:rgba(255,255,255,0.08); color:#fff;}
  nav.tabs button.active{background:#EEEDE4; color:var(--accent); font-weight:600;}

  main{max-width:1180px; margin:0 auto; padding:36px 24px 80px; position:relative; z-index:1;}
  .page{display:none; animation:fade .25s ease;}
  .page.active{display:block;}
  @keyframes fade{from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:translateY(0);}}

  /* ===== HOME ===== */
  .hero{
    display:grid; grid-template-columns:1.15fr 0.85fr; gap:40px;
    padding:42px 0 26px; border-bottom:1px solid var(--line);
  }
  @media (max-width:820px){ .hero{grid-template-columns:1fr;} }
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-size:11.5px; text-transform:uppercase; letter-spacing:1.6px;
    color:var(--accent); font-weight:600; margin-bottom:14px;
  }
  .eyebrow::before{content:""; width:18px; height:2px; background:var(--risk); display:inline-block;}
  .hero h1{font-size:42px; line-height:1.12; margin:0 0 16px; font-weight:700;}
  .hero p.lede{font-size:16px; color:var(--ink-soft); max-width:52ch; margin:0 0 22px;}
  .hero-cta{display:flex; gap:12px; flex-wrap:wrap;}
  .btn{
    font-family:'Inter',sans-serif; font-weight:600; font-size:14px;
    padding:11px 20px; border-radius:2px; cursor:pointer; border:1.5px solid var(--ink);
    background:var(--ink); color:var(--paper); transition:transform .12s;
  }
  .btn:hover{transform:translateY(-1px);}
  .btn.ghost{background:transparent; color:var(--ink); border-color:var(--line-strong);}

  .stat-stamp-grid{display:grid; grid-template-columns:1fr 1fr; gap:14px;}
  .stamp{
    border:1.5px solid var(--line-strong); background:var(--paper-raised);
    padding:18px 16px; position:relative;
  }
  .stamp .num{font-family:'Roboto Slab',serif; font-weight:700; font-size:30px; color:var(--accent);}
  .stamp .label{font-size:12px; color:var(--ink-soft); margin-top:4px; line-height:1.35;}

  .howitworks{padding:40px 0; border-bottom:1px solid var(--line);}
  .section-title{font-size:22px; margin:0 0 6px; font-weight:700;}
  .section-sub{color:var(--ink-soft); font-size:14px; margin:0 0 26px;}
  .steps{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
  @media (max-width:820px){ .steps{grid-template-columns:1fr;} }
  .step{border-top:3px solid var(--accent); padding-top:14px;}
  .step .step-eyebrow{font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--accent); font-weight:600;}
  .step h3{font-size:17px; margin:8px 0 8px;}
  .step p{font-size:13.5px; color:var(--ink-soft); margin:0;}

  .sdg-band{
    margin-top:36px; display:flex; align-items:center; gap:16px;
    background:var(--accent-soft); border:1px solid #B9C7CD; padding:16px 20px;
  }
  .sdg-badge{
    flex-shrink:0; width:52px; height:52px; border-radius:50%;
    background:var(--accent); color:#fff; display:flex; align-items:center; justify-content:center;
    font-family:'Roboto Slab',serif; font-weight:700; font-size:13px; text-align:center; line-height:1.1;
  }
  .sdg-band p{margin:0; font-size:13.5px; color:var(--ink);}

  /* ===== DASHBOARD ===== */
  .dash-head{display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:18px; flex-wrap:wrap; gap:12px;}
  .controls{display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px;}
  .controls input[type=text]{
    padding:9px 12px; border:1.5px solid var(--line-strong); background:var(--paper-raised);
    font-family:'Inter',sans-serif; font-size:13.5px; min-width:200px; color:var(--ink);
  }
  .controls select{
    padding:9px 12px; border:1.5px solid var(--line-strong); background:var(--paper-raised);
    font-family:'Inter',sans-serif; font-size:13.5px; color:var(--ink);
  }
  .legend{display:flex; gap:16px; font-size:12.5px; color:var(--ink-soft); align-items:center;}
  .legend .dot{width:9px; height:9px; border-radius:50%; display:inline-block; margin-right:5px;}

  table.roster{width:100%; border-collapse:collapse; background:var(--paper-raised); border:1px solid var(--line);}
  table.roster thead th{
    text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:0.9px;
    color:var(--ink-soft); font-weight:600; padding:11px 14px; border-bottom:2px solid var(--ink);
  }
  table.roster tbody tr{border-bottom:1px solid var(--line); cursor:pointer; transition:background .12s;}
  table.roster tbody tr:hover{background:var(--accent-soft);}
  table.roster tbody td{padding:12px 14px; font-size:13.5px; vertical-align:middle;}
  .student-name{font-weight:600;}
  .student-meta{font-size:11.5px; color:var(--ink-soft);}

  .risk-pill{
    display:inline-flex; align-items:center; gap:6px;
    font-family:'IBM Plex Mono',monospace; font-weight:600; font-size:12px;
    padding:4px 9px; border-radius:20px;
  }
  .risk-pill.safe{background:var(--safe-bg); color:var(--safe);}
  .risk-pill.watch{background:var(--watch-bg); color:var(--watch);}
  .risk-pill.risk{background:var(--risk-bg); color:var(--risk);}

  .ticks{display:flex; gap:2px;}
  .tick{width:7px; height:16px; border-radius:1px;}
  .tick.present{background:var(--safe);}
  .tick.absent{background:var(--risk); opacity:.8;}

  /* ===== STUDENT DETAIL PANEL ===== */
  .detail-wrap{display:none; margin-top:26px;}
  .detail-wrap.active{display:block;}
  .detail-card{
    background:var(--paper-raised); border:1.5px solid var(--ink); padding:0;
  }
  .detail-topline{
    display:flex; justify-content:space-between; align-items:center;
    padding:16px 22px; border-bottom:1px solid var(--line); background:var(--accent); color:#fff;
  }
  .detail-topline h2{margin:0; font-size:20px;}
  .close-btn{background:none; border:1px solid rgba(255,255,255,0.5); color:#fff; padding:5px 12px; cursor:pointer; font-size:12px; border-radius:2px;}
  .detail-body{display:grid; grid-template-columns:200px 1fr 1fr; gap:0;}
  @media (max-width:900px){ .detail-body{grid-template-columns:1fr;} }
  .seal-col{
    padding:26px 22px; border-right:1px solid var(--line); display:flex; flex-direction:column; align-items:center; gap:14px;
  }
  .seal{
    width:120px; height:120px; border-radius:50%; border:4px double currentColor;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    font-family:'Roboto Slab',serif; transform:rotate(-6deg);
  }
  .seal .score{font-size:34px; font-weight:700; line-height:1;}
  .seal .tier{font-size:10.5px; text-transform:uppercase; letter-spacing:1px; margin-top:4px;}
  .seal.safe{color:var(--safe);}
  .seal.watch{color:var(--watch);}
  .seal.risk{color:var(--risk);}
  .seal-col .ticks-label{font-size:11px; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.8px; margin-bottom:-6px;}

  .reasons-col{padding:22px; border-right:1px solid var(--line);}
  .reasons-col h4, .actions-col h4{
    margin:0 0 12px; font-size:12px; text-transform:uppercase; letter-spacing:1px; color:var(--ink-soft);
  }
  .reason-item{
    display:flex; gap:10px; padding:9px 0; border-bottom:1px dashed var(--line); font-size:13.5px;
  }
  .reason-item:last-child{border-bottom:none;}
  .reason-flag{color:var(--risk); font-weight:700; flex-shrink:0;}
  .chart-mini{margin-top:16px;}

  .actions-col{padding:22px;}
  .action-item{
    display:flex; justify-content:space-between; align-items:center;
    padding:9px 0; border-bottom:1px dashed var(--line); font-size:13.5px; gap:10px;
  }
  .action-item:last-child{border-bottom:none;}
  .mark-btn{
    font-size:11.5px; padding:5px 10px; border:1px solid var(--accent); color:var(--accent);
    background:transparent; cursor:pointer; border-radius:2px; font-weight:600; white-space:nowrap;
  }
  .mark-btn.done{background:var(--safe); border-color:var(--safe); color:#fff;}

  /* ===== OVERVIEW ===== */
  .overview-grid{display:grid; grid-template-columns:1fr 1fr; gap:22px; margin-bottom:22px;}
  @media (max-width:820px){ .overview-grid{grid-template-columns:1fr;} }
  .chart-card{background:var(--paper-raised); border:1px solid var(--line); padding:20px;}
  .chart-card h3{margin:0 0 4px; font-size:15px;}
  .chart-card .sub{font-size:12px; color:var(--ink-soft); margin-bottom:14px;}
  .kpi-row{display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:22px;}
  .kpi{border:1px solid var(--line); background:var(--paper-raised); padding:16px;}
  .kpi .num{font-family:'IBM Plex Mono',monospace; font-weight:600; font-size:24px; color:var(--accent);}
  .kpi .label{font-size:12px; color:var(--ink-soft); margin-top:4px;}

  /* ===== UPLOAD ===== */
  .upload-box{
    border:2px dashed var(--line-strong); background:var(--paper-raised);
    padding:46px 20px; text-align:center; margin-bottom:24px;
  }
  .upload-box p{margin:6px 0; color:var(--ink-soft); font-size:13.5px;}
  .form-grid{display:grid; grid-template-columns:1fr 1fr; gap:16px; max-width:640px;}
  @media (max-width:600px){.form-grid{grid-template-columns:1fr;}}
  .form-grid label{font-size:12px; text-transform:uppercase; letter-spacing:0.6px; color:var(--ink-soft); display:block; margin-bottom:5px;}
  .form-grid input{width:100%; padding:9px 10px; border:1.5px solid var(--line-strong); background:var(--paper-raised); font-family:'Inter',sans-serif; font-size:13.5px;}
  .form-grid .full{grid-column:1/-1;}

  /* ===== PRIVACY / ABOUT ===== */
  .prose{max-width:70ch;}
  .prose h3{font-size:16px; margin:26px 0 8px;}
  .prose p{font-size:14.5px; color:var(--ink-soft);}
  .prose ul{padding-left:20px; color:var(--ink-soft); font-size:14.5px;}
  .prose li{margin-bottom:6px;}

  .toast{
    position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(20px);
    background:var(--ink); color:var(--paper); padding:11px 20px; font-size:13px;
    border-radius:2px; opacity:0; transition:all .25s; pointer-events:none; z-index:100;
  }
  .toast.show{opacity:1; transform:translateX(-50%) translateY(0);}
</style>
</head>
<body>

<header class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <svg class="brand-mark" width="38" height="38" viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Jaspon logo">
        <circle cx="19" cy="19" r="17.5" stroke="#EEEDE4" stroke-width="1.4"/>
        <circle cx="19" cy="19" r="14.5" stroke="#EEEDE4" stroke-width="1.4"/>
        <text x="19" y="25" text-anchor="middle" font-family="'Roboto Slab', serif" font-weight="700" font-size="16" fill="#EEEDE4">J</text>
        <line x1="9" y1="29.5" x2="11.3" y2="29.5" stroke="#C9482F" stroke-width="2"/>
        <line x1="26.7" y1="29.5" x2="29" y2="29.5" stroke="#C9482F" stroke-width="2"/>
      </svg>
      <div>
        <div class="brand-name">Jaspon</div>
        <div class="brand-sub">Dropout Early-Warning System</div>
      </div>
    </div>
    <nav class="tabs">
      <button data-page="home" class="active">Home</button>
      <button data-page="dashboard">Dashboard</button>
      <button data-page="overview">Overview</button>
      <button data-page="upload">Upload Data</button>
      <button data-page="privacy">Privacy</button>
      <button data-page="about">About</button>
    </nav>
  </div>
</header>

<main>

  <!-- ============ HOME ============ -->
  <section id="page-home" class="page active">
    <div class="hero">
      <div>
        <div class="eyebrow">SDG 4 — Quality Education</div>
        <h1>Catch the warning signs<br>before a student disappears.</h1>
        <p class="lede">Every year, students quietly drop out — not overnight, but through weeks of falling attendance, slipping grades, and disengagement no one has time to track by hand. Jaspon flags it early, explains why, and suggests what to do next.</p>
        <div class="hero-cta">
          <button class="btn" onclick="goTo('dashboard')">Open Teacher Dashboard</button>
          <button class="btn ghost" onclick="goTo('about')">How it works</button>
        </div>
      </div>
      <div class="stat-stamp-grid">
        <div class="stamp"><div class="num">26%</div><div class="label">of students in under-resourced schools drop out before Class 10</div></div>
        <div class="stamp"><div class="num">~3 months</div><div class="label">Warning signs typically appear before a student fully disengages</div></div>
        <div class="stamp"><div class="num">12</div><div class="label">students currently flagged watch or high-risk in this demo roster</div></div>
        <div class="stamp"><div class="num">1</div><div class="label">dashboard for teachers, counselors, and admins to act together</div></div>
      </div>
    </div>

    <div class="howitworks">
      <h2 class="section-title">How it works</h2>
      <p class="section-sub">Three simple steps, running quietly in the background of the school week.</p>
      <div class="steps">
        <div class="step">
          <div class="step-eyebrow">STEP ONE</div>
          <h3>Collect the signals</h3>
          <p>Attendance, test scores, assignment submissions, and learning-app logins are pulled together automatically — no extra work for teachers.</p>
        </div>
        <div class="step">
          <div class="step-eyebrow">STEP TWO</div>
          <h3>Predict the risk</h3>
          <p>Each student gets a risk score with a plain-English reason — not just a number, but "why": falling attendance, failed tests, low engagement.</p>
        </div>
        <div class="step">
          <div class="step-eyebrow">STEP THREE</div>
          <h3>Take action, track results</h3>
          <p>Counselors get suggested next steps, mark what they tried, and the system tracks whether it actually helped.</p>
        </div>
      </div>
      <div class="sdg-band">
        <div class="sdg-badge">SDG<br>04</div>
        <p>Jaspon is built around SDG 4: Quality Education — helping every child with complete quality, primary and secondary education by catching disengagement early enough to act on it.</p>
      </div>
    </div>
  </section>

  <!-- ============ DASHBOARD ============ -->
  <section id="page-dashboard" class="page">
    <div class="dash-head">
      <div>
        <h2 class="section-title" style="margin-bottom:2px;">Teacher Dashboard</h2>
        <p class="section-sub" style="margin-bottom:0;">Class 10 — Section A · Updated today</p>
      </div>
      <div class="legend">
        <span><span class="dot" style="background:var(--safe)"></span>Safe</span>
        <span><span class="dot" style="background:var(--watch)"></span>Watch</span>
        <span><span class="dot" style="background:var(--risk)"></span>High risk</span>
      </div>
    </div>

    <div class="controls">
      <input type="text" id="searchBox" placeholder="Search student name...">
      <select id="filterSelect">
        <option value="all">All students</option>
        <option value="safe">Safe only</option>
        <option value="watch">Watch only</option>
        <option value="risk">High risk only</option>
      </select>
    </div>

    <table class="roster">
      <thead>
        <tr>
          <th>Student</th>
          <th>Risk</th>
          <th>Attendance (14d)</th>
          <th>Score</th>
        </tr>
      </thead>
      <tbody id="rosterBody"></tbody>
    </table>

    <div class="detail-wrap" id="detailWrap"></div>
  </section>

  <!-- ============ OVERVIEW ============ -->
  <section id="page-overview" class="page">
    <h2 class="section-title" style="margin-bottom:2px;">School Overview</h2>
    <p class="section-sub">Class 10, all sections — this term</p>

    <div class="kpi-row">
      <div class="kpi"><div class="num">142</div><div class="label">Total students tracked</div></div>
      <div class="kpi"><div class="num">31</div><div class="label">Actions taken this month</div></div>
      <div class="kpi"><div class="num">68%</div><div class="label">Improved after intervention</div></div>
    </div>

    <div class="overview-grid">
      <div class="chart-card">
        <h3>Risk distribution</h3>
        <div class="sub">Where the class stands right now</div>
        <canvas id="pieChart" height="220"></canvas>
      </div>
      <div class="chart-card">
        <h3>High-risk count over time</h3>
        <div class="sub">Since interventions began in week 3</div>
        <canvas id="lineChart" height="220"></canvas>
      </div>
    </div>
  </section>

  <!-- ============ UPLOAD ============ -->
  <section id="page-upload" class="page">
    <h2 class="section-title" style="margin-bottom:2px;">Upload Student Data</h2>
    <p class="section-sub">Bring in attendance and marks — from a file, or added by hand.</p>

    <div class="upload-box">
      <div style="font-size:28px;">📄</div>
      <p><strong>Drop a CSV file here</strong>, or click to choose one</p>
      <p>Expected columns: student name, class, attendance %, test scores, last login</p>
      <button class="btn ghost" onclick="showToast('Demo mode — file upload is simulated')">Choose File</button>
